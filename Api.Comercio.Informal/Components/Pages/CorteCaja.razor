@page "/cortedecaja"
@using Api.Comercio.Informal.Components.Layout
@using Api.Entities
@using Api.Entities.DTO
@using Api.Business
@using Api.Entities.Helpers
@using QuestPDF.Fluent
@using QuestPDF.Helpers
@using QuestPDF.Infrastructure
@inject IJSRuntime JSRuntime
@inject IWebHostEnvironment HostEnvironment
@inject BusinessRecaudacion _recaudacionService
@inject BusinessUsuario _usuarioService
@inject AuthenticationStateProvider GetAuthenticationStateProvider
@attribute [Authorize(Roles = "Superadmin , Supervisor, Cobrador")]
@rendermode InteractiveServer

<h3 class="mb-4 text-uppercase" style="color: #333; letter-spacing: 1px;">Generar Corte de Caja</h3>
<hr />

<div class="no-print mb-4">
    <div class="card shadow-sm border-0">
        <div class="card-body bg-light">
            <div style="display: flex !important; flex-direction: row !important; flex-wrap: nowrap !important; align-items: flex-end; gap: 1rem; width: auto; ">

                @* SELECTOR DE COBRADOR *@
                <div style="width: auto; min-width: 160px; padding-bottom:12px; padding-left:10px;">
                    <label class="form-label fw-bold small text-uppercase mb-1">Cobrador</label>
                    <select class="form-select" @bind="idCobradorSeleccionado">
                        <option value="0">-- Seleccione --</option>
                        @foreach (var cob in cobradores)
                        {
                            <option value="@cob.Id">@cob.Nombre @cob.A_paterno</option>
                        }
                    </select>
                </div>

                @* FECHAS *@
                <div style="width: auto; min-width: 160px; padding-bottom:12px">
                    <label class="form-label fw-bold small text-uppercase mb-1">Fecha Inicio</label>
                    <input type="date" class="form-control" @bind="fechaInicio" />
                </div>

                <div style="width: auto; min-width: 160px; padding-bottom:12px">
                    <label class="form-label fw-bold small text-uppercase mb-1">Fecha Fin</label>
                    <input type="date" class="form-control" @bind="fechaFin" />
                </div>

                @* BOTÓN GENERAR *@
                <div class="d-flex gap-2 pb-1">
                    <button class="btn official-btn-primary" @onclick="GenerarCorte" disabled="@cargando">
                        <span><i class="bi bi-search me-2"></i> Consultar</span>
                    </button>
                    @if (mostrarReporte && pdfBase64 != null)
                    {
                        <button class="btn official-btn-outline-secondary" @onclick="DescargarPDF">
                            <i class="bi bi-file-pdf me-2"></i> Descargar
                        </button>

                        @* <button class="btn official-btn-outline-secondary" onclick="window.print()">
                            <i class="bi bi-printer me-2"></i> Imprimir
                        </button> *@
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@* VISOR DE PDF *@
@if (mostrarReporte && pdfBase64 != null)
{
    <div class="pdf-viewer-container shadow-lg animate__animated animate__zoomIn">
        <iframe src="data:application/pdf;base64,@pdfBase64" width="100%" height="800px" style="border: none; border-radius: 8px;"></iframe>
    </div>
}

@code {
    private IEnumerable<DtoUsuario> cobradores = new List<DtoUsuario>();
    private List<Recaudacion> recaudacion = new();
    private DateTime fechaInicio = DateTime.Today;
    private DateTime fechaFin = DateTime.Today;
    private int idCobradorSeleccionado = 0;
    private bool cargando = false;
    private bool mostrarReporte = false;
    private string? pdfBase64 = null;    

    protected override async Task OnInitializedAsync()
    {
        QuestPDF.Settings.License = LicenseType.Community;
        await CargarCobradores();
    }

    private async Task CargarCobradores()
    {
        try
        {
            var usuariosdb = await _usuarioService.GetByRol("Cobrador");
            cobradores = usuariosdb.Select(u => new DtoUsuario
            {
                Id = u.Id,
                Nombre = u.Nombre,
                A_paterno = u.A_paterno,
                A_materno = u.A_materno
            }).ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("Swal.fire", "Error", "No se pudo cargar la lista de cobradores: " + ex.Message, "error");
        }
    }

    private string NombreCobradorSeleccionado()
    {
        var cob = cobradores.FirstOrDefault(c => c.Id == idCobradorSeleccionado);
        return cob != null ? $"{cob.Nombre} {cob.A_paterno} {cob.A_materno}".Trim() : "Todos los cobradores";
    }

    private async Task Imprimir()
    {
        await JSRuntime.InvokeVoidAsync("print");
    }

    private async Task GenerarCorte()
    {
        if (idCobradorSeleccionado <= 0) 
        {
            await JSRuntime.InvokeVoidAsync("Swal.fire", "Atención", "Debe seleccionar un cobrador.", "warning");
            return; 
        }

        cargando = true;
        mostrarReporte = false;
        pdfBase64 = null;

        try
        {
            // 1. Identificamos la zona horaria de México
            var zonaMexico = TimeZoneInfo.FindSystemTimeZoneById("Central Standard Time (Mexico)");

            // 2. Definimos el inicio del día local (00:00:00) y lo pasamos a UTC
            // Forzamos que la propiedad Kind sea 'Unspecified' usando DateTime.SpecifyKind
            // Esto le dice a .NET: "No asumas que esta es la hora del servidor, trátala como una hora neutra"
            //DateTime inicioLocal = fechaInicio.Date;
            DateTime inicioLocal = DateTime.SpecifyKind(fechaInicio.Date, DateTimeKind.Unspecified);
            DateTime inicioUtc = TimeZoneInfo.ConvertTimeToUtc(inicioLocal, zonaMexico);

            // 3. Definimos el fin del día local (23:59:59) y lo pasamos a UTC
            //DateTime finLocal = fechaFin.Date.AddDays(1).AddTicks(-1);
            DateTime finLocal = DateTime.SpecifyKind(fechaFin.Date.AddDays(1).AddTicks(-1), DateTimeKind.Unspecified);
            DateTime finUtc = TimeZoneInfo.ConvertTimeToUtc(finLocal, zonaMexico);


            var resultado = await _recaudacionService.Search(idCobradorSeleccionado, null, inicioUtc, finUtc);
            recaudacion = resultado.ToList();

            if (recaudacion.Any())
            {
                // Generamos el PDF automáticamente para el visor
                byte[] pdfBytes = CrearDocumentoPDF();
                pdfBase64 = Convert.ToBase64String(pdfBytes);
                mostrarReporte = true;
            }
        }
        catch (Exception ex) 
        {
            await JSRuntime.InvokeVoidAsync("Swal.fire", "Error", "Ocurrió un error al generar el PDF: " + ex.Message, "error"); 
        }
        finally 
        {
            cargando = false; 
        }
    }

    // Factorizamos la lógica de QuestPDF en un método que devuelva byte[]
    private byte[] CrearDocumentoPDF()
    {
        QuestPDF.Settings.License = LicenseType.Community;

        string rootPath = HostEnvironment.WebRootPath;
        string imagePath = Path.Combine(rootPath, "img", "escudo.png");

        return Document.Create(container =>
        {
            container.Page(page =>
            {
                page.Size(PageSizes.Letter);
                page.Margin(1, Unit.Centimetre);
                page.PageColor(Colors.White);
                page.DefaultTextStyle(x => x.FontSize(9).FontFamily("Helvetica"));

                // 1. ENCABEZADO (Header)
                page.Header().Column(col =>
                {
                    col.Item().Row(row =>
                    {
                        if (File.Exists(imagePath))
                        {
                            row.ConstantItem(50).Image(imagePath);
                        }

                        row.RelativeItem().Column(titles =>
                        {
                            titles.Item().AlignCenter().Text("H. AYUNTAMIENTO CONSTITUCIONAL").Bold().FontSize(12);
                            titles.Item().AlignCenter().Text("TESORERÍA MUNICIPAL - TIERRA BLANCA, VER.").FontSize(10);
                            titles.Item().AlignCenter().Text("DIRECCIÓN DE INGRESOS").FontSize(10);
                        });

                        row.ConstantItem(50);
                    });

                    col.Item().PaddingVertical(5).LineHorizontal(1).LineColor("#9D2449");

                    col.Item().Row(row =>
                    {
                        row.RelativeItem().Column(c =>
                        {
                            c.Item().Text("REPORTE: CORTE DE CAJA GENERAL").Bold();
                            c.Item().Text($"COBRADOR: {NombreCobradorSeleccionado()}");
                        });
                        row.RelativeItem().AlignRight().Column(c =>
                        {
                            c.Item().Text($"FECHA EMISIÓN: {DateTime.UtcNow.ToLocalString()}");
                            c.Item().Text($"PERIODO: {fechaInicio:dd/MM/yyyy} - {fechaFin:dd/MM/yyyy}");
                        });
                    });
                });

                // 2. CUERPO ÚNICO (Content) - Aquí agrupamos Tabla y Firma
                page.Content().PaddingVertical(10).Column(mainCol =>
                {
                    // Elemento 1: La Tabla
                    mainCol.Item().Table(table =>
                    {
                        table.ColumnsDefinition(columns =>
                        {
                            columns.ConstantColumn(90);
                            columns.ConstantColumn(90);
                            columns.RelativeColumn();
                            columns.RelativeColumn();
                            columns.ConstantColumn(80);
                        });

                        table.Header(header =>
                        {
                            header.Cell().Element(ApplyHeaderStyle).Text("FECHA");
                            header.Cell().Element(ApplyHeaderStyle).Text("FOLIO");
                            header.Cell().Element(ApplyHeaderStyle).Text("CONTRIBUYENTE");
                            header.Cell().Element(ApplyHeaderStyle).Text("CONCEPTO");
                            header.Cell().Element(ApplyHeaderStyle).AlignRight().Text("IMPORTE");
                        });

                        foreach (var item in recaudacion)
                        {
                            table.Cell().Element(ApplyCellStyle).Text(item.Fecha_cobro.ToLocalString("dd/MM/yyyy HH:mm"));
                            table.Cell().Element(ApplyCellStyle).Text(item.Folio_Recibo?.ToString() ?? "");
                            table.Cell().Element(ApplyCellStyle).Text(item.Padron != null
                                ? $"{item.Padron.Nombre} {item.Padron.A_paterno} {item.Padron.A_materno}"
                                : "");
                            table.Cell().Element(ApplyCellStyle).Text(item.Concepto?.Descripcion ?? "");
                            table.Cell().Element(ApplyCellStyle).AlignRight().Text(item.Monto.ToString("C2"));
                        }
                    });

                    // Elementi 2: EL TOTAL ÚNICO 
                    mainCol.Item().PaddingTop(5).AlignRight().Row(row =>
                    {
                        row.Spacing(10);
                        row.RelativeItem().AlignRight().Text("TOTAL RECAUDADO:").Bold();
                        row.ConstantItem(80).AlignRight().Text(recaudacion.Sum(x => (decimal)x.Monto).ToString("C2"))
                           .Bold().FontSize(10).FontColor("#9D2449");
                    });

                    // Elemento 3: Área de Firma 
                    mainCol.Item().PaddingTop(100).AlignCenter().Column(sigCol =>
                    {
                        sigCol.Item().Width(200).LineHorizontal(0.5f).LineColor(Colors.Black);
                        sigCol.Item().PaddingTop(5).AlignCenter().Text("FIRMA DEL CAJERO").Bold();
                        sigCol.Item().AlignCenter().Text(NombreCobradorSeleccionado()).FontSize(9);
                    });
                });

                // 3. PIE DE PÁGINA (Footer)
                page.Footer().AlignCenter().Text(x =>
                {
                    x.Span("Página ");
                    x.CurrentPageNumber();
                    x.Span(" de ");
                    x.TotalPages();
                });
            });
        }).GeneratePdf();
    }

    private async Task DescargarPDF()
    {
        if (string.IsNullOrEmpty(pdfBase64)) return;

        using var stream = new MemoryStream(Convert.FromBase64String(pdfBase64));
        using var streamRef = new DotNetStreamReference(stream);
        await JSRuntime.InvokeVoidAsync("downloadFileFromStream", $"Corte_{DateTime.Now:yyyyMMdd}.pdf", streamRef);
    }

    // CORRECCIÓN DE ESTILOS: Ahora retornan el contenedor para permitir el encadenamiento (.)
    private IContainer ApplyHeaderStyle(IContainer container)
    {
        return container.BorderBottom(1).PaddingVertical(5).DefaultTextStyle(x => x.Bold());
    }

    private IContainer ApplyCellStyle(IContainer container)
    {
        //return container.BorderBottom(0.5f).BorderColor(Colors.Grey.Lighten2).PaddingVertical(3);
        return container.PaddingVertical(3);
    }
}